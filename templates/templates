<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>
        {% block title %}
        Vegetable Market Bill Manager
        {% endblock %}
    </title>

    <link rel="stylesheet"
          href="{{ url_for('static', filename='style.css') }}">

</head>

<body>

<header class="navbar">

    <div class="logo">
        🥕 Vegetable Market
    </div>

    <nav>

        <a href="{{ url_for('dashboard') }}">
            Dashboard
        </a>

        <a href="{{ url_for('hotels') }}">
            Hotels
        </a>

        <a href="{{ url_for('add_bill') }}">
            Add Bill
        </a>

        <a href="{{ url_for('all_bills') }}">
            All Bills
        </a>

    </nav>

</header>


<main class="container">

    {% with messages = get_flashed_messages(with_categories=true) %}

        {% if messages %}

            {% for category, message in messages %}

                <div class="alert {{ category }}">
                    {{ message }}
                </div>

            {% endfor %}

        {% endif %}

    {% endwith %}


    {% block content %}

    {% endblock %}

</main>


<footer>

    <p>
        Vegetable Market Bill Manager © 2026
    </p>

</footer>

</body>
</html>
