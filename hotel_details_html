{% extends "base.html" %}

{% block title %}
{{ hotel.name }}
{% endblock %}

{% block content %}

<div class="section-header">

    <div>

        <h1>
            {{ hotel.name }}
        </h1>

        <p class="subtitle">
            Hotel details and bill history
        </p>

    </div>

    <div>

        <a class="button"
           href="{{ url_for('edit_hotel',
                           hotel_id=hotel.id) }}">
            Edit Hotel
        </a>

        <a class="button"
           href="{{ url_for('add_bill') }}">
            + Add Bill
        </a>

    </div>

</div>


<div class="details-box">

    <p>
        <strong>Owner:</strong>
        {{ hotel.owner_name or "Not provided" }}
    </p>

    <p>
        <strong>Phone:</strong>
        {{ hotel.phone or "Not provided" }}
    </p>

    <p>
        <strong>Address:</strong>
        {{ hotel.address or "Not provided" }}
    </p>

    <p>
        <strong>GST Number:</strong>
        {{ hotel.gst_number or "Not provided" }}
    </p>

</div>


<div class="summary-box">

    <h3>
        Total Recorded Amount
    </h3>

    <p class="number">
        ₹{{ "%.2f"|format(hotel_total) }}
    </p>

</div>


<div class="section">

    <h2>
        Bill History
    </h2>

    {% if bills %}

    <table>

        <thead>

            <tr>

                <th>Bill Number</th>
                <th>Date</th>
                <th>Total</th>
                <th>Action</th>

            </tr>

        </thead>

        <tbody>

        {% for bill in bills %}

            <tr>

                <td>
                    {{ bill.bill_number }}
                </td>

                <td>
                    {{ bill.bill_date }}
                </td>

                <td>
                    ₹{{ "%.2f"|format(bill.total_amount) }}
                </td>

                <td>

                    <a href="{{ url_for(
                        'bill_detail',
                        bill_id=bill.id
                    ) }}">
                        View Bill
                    </a>

                </td>

            </tr>

        {% endfor %}

        </tbody>

    </table>

    {% else %}

        <div class="empty">
            No bills recorded for this hotel.
        </div>

    {% endif %}

</div>

{% endblock %}
